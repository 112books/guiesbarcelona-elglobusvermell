#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════
#  El Globus Vermell — Script de deploy i gestió (desenvolupador)
#  Ús: ./sync-elglobusvermell
# ═══════════════════════════════════════════════════════════════════════

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

REMOTE="origin"
BRANCH_MAIN="main"
BRANCH_DEV="develop"
URL_STAGING="https://112books.github.io/guiesbarcelona-elglobusvermell/"
URL_PROD="https://guiesbarcelona.elglobusvermell.org/"

RED='\033[0;31m'; GRN='\033[0;32m'; YLW='\033[1;33m'
BLU='\033[0;34m'; DIM='\033[2m'; RST='\033[0m'

print() { echo -e "${BLU}▶${RST} $1"; }
ok()    { echo -e "${GRN}✓${RST} $1"; }
err()   { echo -e "${RED}✗ Error:${RST} $1" >&2; }
warn()  { echo -e "${YLW}⚠${RST}  $1"; }
dim()   { echo -e "${DIM}  $1${RST}"; }

require_clean() {
  if ! git diff --quiet || ! git diff --cached --quiet; then
    err "Hi ha canvis sense confirmar. Fes commit (o sync) abans de continuar."
    echo ""
    git status --short
    echo ""
    exit 1
  fi
}

# ── Funcions ──────────────────────────────────────────────────────────

status() {
  echo ""
  CURRENT=$(git branch --show-current)
  print "Branca actual: ${YLW}${CURRENT}${RST}"
  echo ""
  git status --short
  echo ""
  dim "Últims commits:"
  git log --oneline -5
  echo ""
}

sync() {
  CURRENT=$(git branch --show-current)
  print "Sincronitzant amb ${REMOTE}/${CURRENT}..."

  git add -A

  if ! git diff --cached --quiet; then
    read -r -p "  Missatge de commit: " msg
    [[ -z "$msg" ]] && msg="Auto-sync $(date '+%Y-%m-%d %H:%M')"
    git commit -m "$msg"
  fi

  git pull --rebase "$REMOTE" "$CURRENT" || {
    err "Pull/rebase fallat. Resol els conflictes manualment i torna a executar."
    exit 1
  }

  git push "$REMOTE" "$CURRENT" || exit 1
  ok "Sync complet → ${REMOTE}/${CURRENT}"
}

server_local() {
  print "Arrancant servidor local..."
  dim "http://localhost:1313  —  Ctrl+C per aturar"
  echo ""
  hugo server -D
}

build_local() {
  print "Build local (amb drafts)..."
  hugo --minify --buildDrafts || exit 1
  ok "Build correcte → ./public/"
}

deploy_staging() {
  require_clean
  CURRENT=$(git branch --show-current)

  if [[ "$CURRENT" == "$BRANCH_MAIN" ]]; then
    print "Pujant ${BRANCH_MAIN} → GitHub (dispara el GitHub Action de staging)..."
    git push "$REMOTE" "$BRANCH_MAIN" || exit 1
    ok "Deploy staging iniciat."
    dim "GitHub Action construirà i desplegarà en 1-2 min a:"
    dim "$URL_STAGING"
    dim "Segueix el progrés: https://github.com/112books/guiesbarcelona-elglobusvermell/actions"
  else
    warn "Estàs a '${CURRENT}', no a '${BRANCH_MAIN}'."
    read -r -p "  Vols fer merge de ${CURRENT} → ${BRANCH_MAIN} i desplegar? [s/N] " confirm
    if [[ "$confirm" =~ ^[Ss]$ ]]; then
      git checkout "$BRANCH_MAIN"
      print "Fent merge de ${CURRENT}..."
      git merge "$CURRENT" --no-edit || {
        err "Merge fallat. Resol els conflictes manualment."
        exit 1
      }
      git push "$REMOTE" "$BRANCH_MAIN" || exit 1
      ok "Deploy staging iniciat → ${URL_STAGING}"
    else
      err "Opera des de la branca ${BRANCH_MAIN} o confirma el merge."
      exit 1
    fi
  fi
}

nou_element() {
  echo ""
  dim "  Crea només l'esquelet buit. Després: omple la fitxa i afegeix el slug de la"
  dim "  guia al camp 'publicacions' perquè el punt surti al mapa."
  read -r -p "  Slug de l'element (ex: casa-mila): " slug
  [[ -z "$slug" ]] && { err "El slug no pot estar buit."; exit 1; }
  hugo new content "ca/elements/${slug}.md"
  ok "Creat: content/ca/elements/${slug}.md"
}

nova_publicacio() {
  echo ""
  dim "  Crea només l'esquelet buit. Després: omple títol, edició i cos, i puja la"
  dim "  portada i el PDF des del CMS o a mà."
  read -r -p "  Slug de la publicació (ex: barceloneta): " slug
  [[ -z "$slug" ]] && { err "El slug no pot estar buit."; exit 1; }
  hugo new content "ca/publicacions/${slug}/_index.md"
  ok "Creat: content/ca/publicacions/${slug}/_index.md"
}

nou_arquitecte() {
  echo ""
  dim "  Crea només l'esquelet buit. Després: omple la descripció; els vincles amb"
  dim "  els elements surten de cada fitxa d'element i de les intervencions."
  read -r -p "  Slug de l'arquitecte (ex: jose-luis-sert): " slug
  [[ -z "$slug" ]] && { err "El slug no pot estar buit."; exit 1; }
  hugo new content "ca/arquitectes/${slug}.md"
  ok "Creat: content/ca/arquitectes/${slug}.md"
}

ajuda() {
  echo ""
  echo "  Termes d'aquest projecte:"
  echo "   · element    → un punt del mapa: un edifici o espai. Viu a content/ca/elements/."
  echo "   · publicació → un plànol-guia de la col·lecció (NO un article de blog)."
  echo "                   Viu a content/ca/publicacions/<slug>/_index.md."
  echo "   · arquitecte → fitxa d'arquitecte o estudi, enllaçada des de les fitxes."
  echo ""
  echo "  Important: les opcions 'e', 'p' i 'a' NOMÉS creen un fitxer buit (esquelet)"
  echo "  amb 'hugo new'. No omplen cap dada ni afegeixen el punt a cap guia."
  echo "  Un cop creat, obre el CMS (/admin/) o edita el Markdown a mà per omplir el"
  echo "  contingut. Per als elements, recorda afegir el slug de la guia al camp"
  echo "  'publicacions' perquè el punt surti al mapa de la guia corresponent."
  echo ""
}

# ── Menú ──────────────────────────────────────────────────────────────

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo " El Globus Vermell — Deploy & Gestió"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
CURRENT=$(git branch --show-current 2>/dev/null || echo "?")
echo -e " Branca: ${YLW}${CURRENT}${RST}"
echo ""
echo " 1) Status del repo"
echo " 2) Sync  (commit + pull --rebase + push)"
echo " 3) Servidor local  →  localhost:1313"
echo " 4) Build local (amb drafts)"
echo "───────────────────────────────────────────────"
echo " 5) Deploy  →  GitHub Pages (via GitHub Actions)"
echo "───────────────────────────────────────────────"
echo " e) Nou element"
echo "      Punt del mapa (edifici o espai). Només crea l'esquelet buit."
echo " p) Nova publicació"
echo "      Plànol-guia de la col·lecció (no un article). Només crea l'esquelet."
echo " a) Nou arquitecte"
echo "      Fitxa d'arquitecte o estudi. Només crea l'esquelet buit."
echo " h) Ajuda  (què vol dir cada terme i què falta després)"
echo "───────────────────────────────────────────────"
echo " 0) Sortir"
echo ""

read -r -p "Opció: " opt
echo ""

case $opt in
  1) status ;;
  2) sync ;;
  3) server_local ;;
  4) build_local ;;
  5) deploy_staging ;;
  e) nou_element ;;
  p) nova_publicacio ;;
  a) nou_arquitecte ;;
  h) ajuda ;;
  0) exit 0 ;;
  *) err "Opció no vàlida: '${opt}'"; exit 1 ;;
esac

echo ""
